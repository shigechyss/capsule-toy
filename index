<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ガシャポン</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Arial', sans-serif;
            background: linear-gradient(135deg, #1a0033 0%, #2d0052 100%);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }

        .container {
            text-align: center;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 20px;
            padding: 40px 30px;
            backdrop-filter: blur(10px);
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
            max-width: 600px;
            width: 100%;
        }

        h1 {
            color: #ff1493;
            margin-bottom: 10px;
            font-size: 24px;
            text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
        }

        .subtitle {
            color: #ffb6d9;
            font-size: 14px;
            margin-bottom: 20px;
        }

        .series-selector {
            margin-bottom: 25px;
            background: rgba(0, 0, 0, 0.2);
            padding: 15px;
            border-radius: 10px;
        }

        .series-selector label {
            color: #ffb6d9;
            margin-right: 10px;
            font-weight: bold;
            display: block;
            margin-bottom: 8px;
        }

        .series-selector select {
            padding: 10px 15px;
            border-radius: 8px;
            border: 2px solid #ff1493;
            background: rgba(255, 255, 255, 0.95);
            color: #333;
            font-weight: bold;
            cursor: pointer;
            font-size: 14px;
            width: 100%;
            max-width: 300px;
        }

        .series-selector select:hover {
            background: rgba(255, 255, 255, 1);
            box-shadow: 0 4px 10px rgba(255, 20, 147, 0.3);
        }

        .display-container {
            background: linear-gradient(to bottom, #ff1493, #c71585);
            border-radius: 15px;
            padding: 20px;
            margin-bottom: 30px;
            box-shadow: inset 0 2px 5px rgba(0, 0, 0, 0.2), 0 5px 15px rgba(0, 0, 0, 0.3);
            border: 3px solid #ff69b4;
            min-height: 350px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }

        .main-image {
            max-width: 100%;
            max-height: 400px;
            height: auto;
            border-radius: 10px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
        }

        .figure-image {
            max-width: 250px;
            height: auto;
            border-radius: 10px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
            opacity: 0;
            animation: spin-and-appear 0.6s ease-in-out forwards;
        }

        @keyframes spin-and-appear {
            0% {
                opacity: 0;
                transform: rotateY(-90deg) scale(0.5);
            }
            100% {
                opacity: 1;
                transform: rotateY(0deg) scale(1);
            }
        }

        .figure-name {
            color: white;
            font-size: 16px;
            font-weight: bold;
            text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.5);
            margin-top: 15px;
        }

        .button-container {
            display: flex;
            gap: 10px;
            justify-content: center;
            flex-wrap: wrap;
        }

        button {
            background: linear-gradient(to bottom, #ff1493, #c71585);
            color: white;
            border: 2px solid white;
            padding: 15px 30px;
            font-size: 16px;
            font-weight: bold;
            border-radius: 50px;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        button:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 20px rgba(255, 20, 147, 0.5);
        }

        button:active {
            transform: translateY(-1px);
        }

        button:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        .info {
            color: #ffb6d9;
            font-size: 12px;
            margin-top: 20px;
            line-height: 1.6;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>🎪 ガシャポン 🎪</h1>

        <div class="series-selector">
            <label for="series">シリーズを選択:</label>
            <select id="series" onchange="switchSeries()">
                <option value="keko-chan">ゴスロリけー虎ちゃん</option>
                <option value="onion">玉ねぎ令嬢 ゴスロリコレクション</option>
            </select>
        </div>

        <p class="subtitle" id="seriesSubtitle">ゴスロリけー虎ちゃん</p>

        <div class="display-container" id="displayContainer">
            <img id="mainDisplay" src="data:image/png;base64," class="main-image" alt="ゴスロリけー虎ちゃん">
        </div>

        <div class="button-container">
            <button onclick="gacha()">🎰 ガシャガシャ！</button>
            <button onclick="resetDisplay()">もう一度見る</button>
        </div>

        <div class="info">
            <p id="seriesInfo">💚 全5種+シークレット</p>
        </div>
    </div>

    <script>
        // ===== フィギュア画像データ =====
        // けー虎ちゃん用フィギュア（Base64）
        const kekoFigureImages = [
            "data:image/png;base64,",
            "data:image/png;base64,",
            "data:image/png;base64,",
            "data:image/png;base64,",
            "data:image/png;base64,",
            "data:image/png;base64,",
        ];

        // 玉ねぎ令嬢用フィギュア（ダミー - 後で置き換え予定）
        const onionFigureImages = [
            "data:image/png;base64,",
            "data:image/png;base64,",
            "data:image/png;base64,",
            "data:image/png;base64,",
            "data:image/png;base64,",
            "data:image/png;base64,",
        ];

        // 元画像
        const originalImages = {
            'keko-chan': "data:image/png;base64,",
            'onion': "data:image/png;base64,"
        };

        // ===== シリーズデータ =====
        const seriesData = {
            'keko-chan': {
                name: 'ゴスロリけー虎ちゃん',
                subtitle: 'ゴスロリけー虎ちゃん',
                figures: [
                    { name: '①にっこりボーズ', image: kekoFigureImages[0] },
                    { name: '②ウインク♡', image: kekoFigureImages[1] },
                    { name: '③ぬいぐるみといっしょ', image: kekoFigureImages[2] },
                    { name: '④おすわり', image: kekoFigureImages[3] },
                    { name: '⑤すやすや', image: kekoFigureImages[4] },
                    { name: 'シークレット', image: kekoFigureImages[5] }
                ]
            },
            'onion': {
                name: '玉ねぎ令嬢 ゴスロリコレクション',
                subtitle: '玉ねぎ令嬢',
                figures: [
                    { name: '①おすまし', image: onionFigureImages[0] },
                    { name: '②はにかみ', image: onionFigureImages[1] },
                    { name: '③おでかけ', image: onionFigureImages[2] },
                    { name: '④おすわり', image: onionFigureImages[3] },
                    { name: '⑤うとうと', image: onionFigureImages[4] },
                    { name: 'ひみつのすがた', image: onionFigureImages[5] }
                ]
            }
        };

        let currentSeries = 'keko-chan';

        function switchSeries() {
            currentSeries = document.getElementById('series').value;
            const series = seriesData[currentSeries];
            document.getElementById('seriesSubtitle').textContent = series.subtitle;
            resetDisplay();
        }

        function gacha() {
            const series = seriesData[currentSeries];
            
            if (!series || series.figures.length === 0) {
                alert('シリーズデータが見つかりません');
                return;
            }

            // ランダムに1つ選択
            const randomIndex = Math.floor(Math.random() * series.figures.length);
            const selected = series.figures[randomIndex];

            // 表示を変更
            const display = document.getElementById('mainDisplay');
            display.className = 'figure-image';
            display.src = selected.image;
            display.alt = selected.name;

            // 名前を追加
            const container = document.getElementById('displayContainer');
            let nameElement = container.querySelector('.figure-name');
            if (!nameElement) {
                nameElement = document.createElement('p');
                nameElement.className = 'figure-name';
                container.appendChild(nameElement);
            }
            nameElement.textContent = selected.name;
        }

        function resetDisplay() {
            const display = document.getElementById('mainDisplay');
            const series = seriesData[currentSeries];
            
            display.className = 'main-image';
            display.src = originalImages[currentSeries];
            display.alt = series.name;

            // 名前を削除
            const container = document.getElementById('displayContainer');
            const nameElement = container.querySelector('.figure-name');
            if (nameElement) {
                nameElement.remove();
            }
        }
    </script>
</body>
</html>
